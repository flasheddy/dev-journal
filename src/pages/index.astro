---
import PostItem from '../components/PostItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, getProjects, slugifyTag } from '../lib/posts';
import { site } from '../lib/site';

const posts = await getPosts();
const latestPosts = posts.slice(0, 3);
const projects = await getProjects();

const projectTagCounts = new Map<string, { name: string; slug: string; count: number }>();
for (const project of projects) {
  const seenInProject = new Set<string>();
  for (const tech of project.data.tech) {
    const slug = slugifyTag(tech);
    if (!slug || seenInProject.has(slug)) continue;
    seenInProject.add(slug);
    const existing = projectTagCounts.get(slug);
    if (existing) {
      existing.count += 1;
    } else {
      projectTagCounts.set(slug, { name: tech, slug, count: 1 });
    }
  }
}
const projectTags = [...projectTagCounts.values()].sort(
  (a, b) => b.count - a.count || a.name.localeCompare(b.name),
);
---

<BaseLayout>
  <section class="intro shell" aria-labelledby="intro-title">
    <p class="intro__mark" aria-hidden="true">~/</p>
    <div>
      <h1 id="intro-title">Hi, I’m Chen.</h1>
      <p>
        I write about extraction infrastructure, adversarial data pipelines, and local-first
        software with Rust and Python.
      </p>
    </div>
  </section>

  <section class="project-band" id="projects" aria-labelledby="project-title">
    <div class="shell">
      <div class="section-heading section-heading--projects">
        <h2 id="project-title">{site.projects.title}</h2>
        <span class="section-rule" aria-hidden="true"></span>
        {
          projectTags.length > 0 && (
            <div
              class="project-filter"
              role="group"
              aria-label="Filter projects by technology"
              data-project-filter
            >
              <button
                type="button"
                class="topic-filter__pill project-filter__pill is-active"
                data-filter-tag="all"
                aria-pressed="true"
              >
                All
              </button>
              {projectTags.map((tag) => (
                <button
                  type="button"
                  class="topic-filter__pill project-filter__pill"
                  data-filter-tag={tag.slug}
                  aria-pressed="false"
                >
                  {tag.name}
                </button>
              ))}
            </div>
          )
        }
      </div>
      <div class="project-list" data-project-list>
        {projects.map((project) => <ProjectCard project={project} />)}
        <p class="empty-state" data-project-empty hidden>
          No projects match this technology.
        </p>
      </div>
    </div>
  </section>

  <section class="article-feed shell" aria-labelledby="articles-title">
    <div class="section-heading">
      <h2 id="articles-title">Latest articles</h2>
      <a href="/blog/">View all</a>
    </div>
    <div class="post-list">
      {
        latestPosts.length > 0 ? (
          latestPosts.map((post) => <PostItem post={post} />)
        ) : (
          <p class="empty-state">No articles yet. The first field note is on its way.</p>
        )
      }
    </div>
    {
      posts.length > 0 && (
        <div class="article-feed__footer">
          <a class="feed-more-link" href="/blog/">
            View all posts <span aria-hidden="true">→</span>
          </a>
        </div>
      )
    }
  </section>
</BaseLayout>
