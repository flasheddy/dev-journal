---
import { ClientRouter } from 'astro:transitions';
import { site } from '../lib/site';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site ?? site.url).href;
const isNavActive = (href: string) =>
  href === '/blog/' && (pathname.startsWith('/blog/') || pathname.startsWith('/tags/'));
---

<!doctype html>
<html lang="en" data-theme="mocha">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1e1e2e" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('dev-journal-theme');
          document.documentElement.dataset.theme = saved === 'latte' ? 'latte' : 'mocha';
        } catch (_) {
          document.documentElement.dataset.theme = 'mocha';
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header" transition:name="site-header" transition:animate="none">
      <div class="site-header__inner shell">
        <a class="site-name" href="/">Dev Journal</a>
        <nav class="site-nav" aria-label="Primary navigation">
          {
            site.nav.map((item) => {
              const isInternal = item.href.startsWith('/');
              const active = isNavActive(item.href);

              return isInternal ? (
                <a
                  class:list={['site-nav__link', { 'is-active': active }]}
                  href={item.href}
                  aria-current={pathname === item.href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ) : (
                <a
                  class="external-link"
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                >
                  {item.label} <span aria-hidden="true">↗</span>
                </a>
              );
            })
          }
          <button
            class="icon-button theme-toggle"
            type="button"
            data-theme-toggle
            aria-label="Switch to light theme"
            aria-pressed="false"
          >
            <svg
              data-theme-icon="sun"
              aria-hidden="true"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"
              ></path>
            </svg>
            <svg
              data-theme-icon="moon"
              aria-hidden="true"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main-content" transition:name="main-content">
      <slot />
    </main>

    <footer class="site-footer" transition:name="site-footer" transition:animate="none">
      <div class="shell site-footer__inner">
        <p>Dev Journal</p>
        <p>Built with Astro.</p>
      </div>
    </footer>
    <div class="sr-only" aria-live="polite" aria-atomic="true" data-copy-status></div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
