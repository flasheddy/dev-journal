{
  "name": "dev-journal",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Static engineering journal built with Astro and Bun.",
  "scripts": {
    "dev": "bun astro dev",
    "build": "bun astro build",
    "preview": "bun astro preview",
    "start": "bun astro preview",
    "check": "bun astro check && bun scripts/check.ts && bun test tests/unit",
    "check:source": "bun scripts/check.ts",
    "check:built": "bun scripts/check.ts --built",
    "check:built:canary": "bun scripts/check-canary.ts",
    "test": "bun test tests/unit",
    "test:visual": "playwright test",
    "test:visual:headed": "playwright test --headed",
    "report": "playwright show-report .visual/report"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/sitemap": "3.7.6",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "22.20.5",
    "astro": "7.4.13",
    "satori": "^0.63.2",
    "smol-toml": "1.9.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.5"
  }
}
