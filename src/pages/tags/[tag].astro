---
import PostItem from '../../components/PostItem.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTagIndex, type TagEntry } from '../../lib/posts';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const tags = await getTagIndex();

  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tag },
  }));
}

interface Props {
  tag: TagEntry;
}

const { tag } = Astro.props;
const count = tag.posts.length;
const description = `${count} ${count === 1 ? 'article' : 'articles'} tagged “${tag.name}”.`;
---

<BaseLayout title={tag.name} description={description}>
  <section class="archive shell">
    <header class="page-heading">
      <a class="back-link page-heading__back" href="/blog/">← Back to Articles</a>
      <p class="page-heading__context">{site.tags.context}</p>
      <h1>{tag.name}</h1>
      <p>{description}</p>
    </header>
    <div class="post-list">
      {tag.posts.map((post) => <PostItem post={post} />)}
    </div>
  </section>
</BaseLayout>
