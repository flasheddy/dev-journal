---
import { ClientRouter } from 'astro:transitions';
import { site } from '../lib/site';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}

const { title, description = site.description, type = 'website', jsonLd } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const pathname = Astro.url.pathname;
const baseUrl = Astro.site ?? new URL(site.url);
const canonical = new URL(pathname, baseUrl).href;
const feedUrl = new URL('/rss.xml', baseUrl).href;
const jsonLdMarkup = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
const isNavActive = (href: string) =>
  href === '/blog/' && (pathname.startsWith('/blog/') || pathname.startsWith('/tags/'));
---

<!doctype html>
<html lang="en" data-theme="mocha">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1e1e2e" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} RSS`} href={feedUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {jsonLdMarkup && <script is:inline type="application/ld+json" set:html={jsonLdMarkup} />}
    <title>{pageTitle}</title>
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('dev-journal-theme');
          document.documentElement.dataset.theme = saved === 'latte' ? 'latte' : 'mocha';
        } catch (_) {
          document.documentElement.dataset.theme = 'mocha';
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header" transition:name="site-header" transition:animate="none">
      <div class="site-header__inner shell">
        <a class="site-name" href="/">Dev Journal</a>
        <nav class="site-nav" aria-label="Primary navigation">
          {
            site.nav.map((item) => {
              const isInternal = item.href.startsWith('/');
              const active = isNavActive(item.href);

              return isInternal ? (
                <a
                  class:list={['site-nav__link', { 'is-active': active }]}
                  href={item.href}
                  aria-current={pathname === item.href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ) : (
                <a
                  class="external-link"
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                >
                  {item.label} <span aria-hidden="true">↗</span>
                </a>
              );
            })
          }
          <button
            class="search-trigger"
            type="button"
            data-search-trigger
            aria-label="Search articles and projects"
            aria-keyshortcuts="Control+K Meta+K"
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="command-palette"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
            <kbd class="search-trigger__kbd" data-search-kbd>⌘K</kbd>
          </button>
          <button
            class="ask-trigger"
            type="button"
            data-ask-trigger
            aria-label="Ask Journal"
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="ask-journal-modal"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              width="15"
              height="15"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M12 3l1.9 4.6L18.5 9.5l-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3z"
              ></path>
              <path d="M19 16l.8 1.9L21.7 18.7l-1.9.8L19 21.4l-.8-1.9-1.9-.8 1.9-.8L19 16z"></path>
            </svg>
            <span class="ask-trigger__label">Ask</span>
          </button>
          <button
            class="icon-button theme-toggle"
            type="button"
            data-theme-toggle
            aria-label="Switch to light theme"
            aria-pressed="false"
          >
            <svg
              data-theme-icon="sun"
              aria-hidden="true"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path
                d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"
              ></path>
            </svg>
            <svg
              data-theme-icon="moon"
              aria-hidden="true"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main-content" transition:name="main-content">
      <slot />
    </main>

    <footer class="site-footer" transition:name="site-footer" transition:animate="none">
      <div class="shell site-footer__inner">
        <p>Dev Journal</p>
        <p>
          Built with Astro. <span aria-hidden="true">·</span>
          <a class="site-footer__rss" href="/rss.xml">RSS</a>
        </p>
      </div>
    </footer>
    <div
      id="command-palette"
      class="command-palette"
      role="dialog"
      aria-modal="true"
      aria-labelledby="command-palette-label"
      data-command-palette
      hidden
    >
      <div class="command-palette__backdrop" data-command-backdrop></div>
      <div class="command-palette__panel" role="document">
        <div class="command-palette__header">
          <svg
            class="command-palette__icon"
            aria-hidden="true"
            viewBox="0 0 24 24"
            width="17"
            height="17"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
          <label id="command-palette-label" class="sr-only" for="command-palette-input">
            Search articles and projects
          </label>
          <input
            id="command-palette-input"
            class="command-palette__input"
            type="search"
            placeholder="Search articles, projects, and topics…"
            autocomplete="off"
            spellcheck="false"
            role="combobox"
            aria-expanded="true"
            aria-autocomplete="list"
            aria-controls="command-palette-results"
            data-command-input
          />
          <button
            type="button"
            class="command-palette__esc"
            data-command-close
            aria-label="Close search"
          >
            Esc
          </button>
        </div>
        <div class="command-palette__body">
          <p
            class="command-palette__status"
            data-command-status
            role="status"
            aria-live="polite"
            hidden
          >
          </p>
          <ul
            id="command-palette-results"
            class="command-palette__results"
            role="listbox"
            aria-label="Search results"
            data-command-results
          >
          </ul>
        </div>
        <div class="command-palette__footer" aria-hidden="true">
          <span class="command-palette__hint"><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
          <span class="command-palette__hint"><kbd>↵</kbd> Open</span>
          <span class="command-palette__hint"><kbd>Esc</kbd> Close</span>
        </div>
      </div>
    </div>
    <div
      id="ask-journal-modal"
      class="ask-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="ask-journal-title"
      data-ask-modal
      hidden
    >
      <div class="ask-modal__backdrop" data-ask-backdrop></div>
      <div class="ask-modal__panel" role="document">
        <div class="ask-modal__header">
          <div class="ask-modal__heading">
            <svg
              class="ask-modal__icon"
              aria-hidden="true"
              viewBox="0 0 24 24"
              width="17"
              height="17"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M12 3l1.9 4.6L18.5 9.5l-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3z"
              ></path>
              <path d="M19 16l.8 1.9L21.7 18.7l-1.9.8L19 21.4l-.8-1.9-1.9-.8 1.9-.8L19 16z"></path>
            </svg>
            <h2 id="ask-journal-title" class="ask-modal__title">Ask Journal</h2>
          </div>
          <button
            type="button"
            class="command-palette__esc"
            data-ask-close
            aria-label="Close Ask Journal"
          >
            Esc
          </button>
        </div>

        <form class="ask-modal__form" data-ask-form>
          <label class="sr-only" for="ask-journal-input">
            Ask a question about articles and projects
          </label>
          <input
            id="ask-journal-input"
            class="ask-modal__input"
            type="text"
            placeholder="Ask about dotfiles, commit gates, Astro, or projects…"
            autocomplete="off"
            spellcheck="false"
            data-ask-input
          />
          <button type="submit" class="ask-modal__submit" data-ask-submit>Ask</button>
        </form>

        <div class="ask-modal__body">
          <div class="ask-modal__prompts" data-ask-prompts>
            <p class="ask-modal__section-label">Try asking</p>
            <div class="ask-modal__prompt-list">
              <button
                type="button"
                class="ask-modal__prompt"
                data-ask-suggestion="How does the dotfiles threat model guard AI agents?"
              >
                How does the dotfiles threat model guard AI agents?
              </button>
              <button
                type="button"
                class="ask-modal__prompt"
                data-ask-suggestion="Why keep language toolchains out of the package manager?"
              >
                Why keep language toolchains out of the package manager?
              </button>
              <button
                type="button"
                class="ask-modal__prompt"
                data-ask-suggestion="How does offline visual verification work with Bun and Playwright?"
              >
                How does offline visual verification work with Bun and Playwright?
              </button>
            </div>
          </div>

          <p
            class="ask-modal__status"
            data-ask-status
            role="status"
            aria-live="polite"
            hidden
          >
          </p>

          <section class="ask-modal__answer" data-ask-answer hidden aria-live="polite">
            <div class="ask-modal__answer-head">
              <span class="ask-modal__mode" data-ask-mode></span>
            </div>
            <p class="ask-modal__answer-text" data-ask-answer-text></p>
          </section>

          <section class="ask-modal__citations" data-ask-citations hidden>
            <p class="ask-modal__section-label">Top citations</p>
            <ol class="ask-modal__citation-list" data-ask-citation-list></ol>
          </section>
        </div>

        <div class="command-palette__footer" aria-hidden="true">
          <span class="command-palette__hint"><kbd>↵</kbd> Ask</span>
          <span class="command-palette__hint"><kbd>Tab</kbd> Focus</span>
          <span class="command-palette__hint"><kbd>Esc</kbd> Close</span>
        </div>
      </div>
    </div>
    <div class="sr-only" aria-live="polite" aria-atomic="true" data-copy-status></div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
