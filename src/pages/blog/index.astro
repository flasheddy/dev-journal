---
import PostItem from '../../components/PostItem.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getTagIndex } from '../../lib/posts';
import { site } from '../../lib/site';

const posts = await getPosts();
const tags = (await getTagIndex()).sort(
  (a, b) => b.posts.length - a.posts.length || a.name.localeCompare(b.name),
);
const visibleTagLimit = 7;
const primaryTags = tags.slice(0, visibleTagLimit);
const overflowTags = tags.slice(visibleTagLimit);
const countLabel = `${posts.length} ${posts.length === 1 ? 'post' : 'posts'}`;
---

<BaseLayout title={site.blog.title} description={site.blog.description}>
  <section class="archive shell">
    <header class="page-heading page-heading--archive">
      <h1>{site.blog.title}</h1>
      <div class="page-heading__subrow">
        <p class="page-heading__description">{site.blog.description}</p>
        <p class="archive-count" data-archive-count aria-live="polite">{countLabel}</p>
      </div>
      {
        tags.length > 0 && (
          <div
            class="topic-filter"
            role="group"
            aria-label="Filter articles by topic"
            data-topic-filter
          >
            <button
              type="button"
              class="topic-filter__pill is-active"
              data-filter-tag="all"
              aria-pressed="true"
            >
              All
            </button>
            {primaryTags.map((tag) => (
              <button
                type="button"
                class="topic-filter__pill"
                data-filter-tag={tag.slug}
                aria-pressed="false"
              >
                {tag.name}
              </button>
            ))}
            {overflowTags.map((tag) => (
              <button
                type="button"
                class="topic-filter__pill"
                data-filter-tag={tag.slug}
                data-filter-overflow
                aria-pressed="false"
                hidden
              >
                {tag.name}
              </button>
            ))}
            {overflowTags.length > 0 && (
              <button
                type="button"
                class="topic-filter__toggle"
                data-filter-toggle
                data-more-label={`+${overflowTags.length} more`}
                aria-expanded="false"
              >
                +{overflowTags.length} more
              </button>
            )}
          </div>
        )
      }
    </header>
    <div class="post-list" data-filter-list>
      {
        posts.length > 0 ? (
          posts.map((post) => <PostItem post={post} />)
        ) : (
          <p class="empty-state">No articles yet. The first field note is on its way.</p>
        )
      }
      <p class="empty-state" data-filter-empty hidden>
        No articles found for this topic.
      </p>
    </div>
  </section>
</BaseLayout>
